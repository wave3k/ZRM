  "responses": {
    "salutation": {
      "standard": "Bonjour {name}. Prêt à manager ta machine ?",
      "repetition": "On est déjà en session, {name}. Quelle commande système veut-tu lancer ?"
    },
    "presentation": {
      "standard": "Enregistré, {name}. Les privilèges de session te sont accordés.",
      "repetition": "Je sais qui tu es, {name}. Concentrons-nous sur le shell."
    },
    "aide": {
      "standard": "Je suis ZRM, ton assistant système local. Demande-moi de checker le disque, le réseau, nettoyer le cache, gérer les fichiers, killer des processus ou d'exécuter des commandes à la volée.",
      "repetition": "Utilise '/' pour le menu système, ou lance directement des commandes système personnalisées."
    },
    "quitter": {
      "standard": "Session système close, {name}. À la prochaine.",
      "repetition": "Fermeture imminente..."
    },
    "sys_disk": {
      "standard": "Analyse de l'espace disque lancée...",
      "repetition": "Nouvelle vérification du stockage en cours..."
    },
    "sys_network": {
      "standard": "Analyse des connexions réseau actives...",
      "repetition": "Re-scannage des ports réseau..."
    },
    "project_clean": {
      "standard": "Amorçage du nettoyage de printemps dans le dossier...",
      "repetition": "Nouveau cycle de nettoyage lancé..."
    },
    "git_check": {
      "standard": "Inspection de l'état du dépôt Git local...",
      "repetition": "Mise à jour du statut Git..."
    },
    "dir_create": {
      "standard": "Préparation à la création du dossier...",
      "repetition": "Nouveau dossier en cours de génération..."
    },
    "file_create": {
      "standard": "Génération de votre nouveau fichier en cours...",
      "repetition": "Création du fichier demandé..."
    },
    "file_rename": {
      "standard": "Traitement de l'opération de renommage...",
      "repetition": "Renommage du fichier d'origine..."
    },
    "file_delete": {
      "standard": "Traitement de la demande de suppression définitive...",
      "repetition": "Préparation à une autre suppression..."
    },
    "process_kill": {
      "standard": "Ciblage et extinction forcée du processus en cours...",
      "repetition": "Arrêt forcé d'un autre processus ciblé..."
    },
    "custom_command": {
      "standard": "Préparation au lancement de votre commande personnalisée...",
      "repetition": "Lancement d'une nouvelle commande personnalisée..."
    }
  },
  "actions": {
    "sys_disk": {
      "win32": "wmic logicaldisk get size,freespace,caption",
      "default": "df -h / | awk 'NR1 || NR2'"
    },
    "sys_network": {
      "win32": "netstat -ano | findstr LISTENING | more",
      "default": "ss -tulpn || netstat -ant"
    },
    "project_clean": {
      "win32": "del /s /q *.log 2>nul & echo Fichiers log nettoyes.",
      "default": "rm -f *.log *.tmp && echo 'Nettoyage des fichiers temporaires effectue.'"
    },
    "git_check": {
      "win32": "git status -s",
      "default": "git status -s"
    }
  }
}
