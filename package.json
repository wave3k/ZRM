{
  "name": "zrm-local-rag",
  "version": "2.0.0",
  "description": "ZRM local RAG - poser des questions sur tes propres donnees, 100% offline.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "zrm": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "web": "node src/server.js",
    "ingest": "node src/cli.js --ingest",
    "ask": "node src/cli.js --ask",
    "model:download": "node scripts/download-models.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@xenova/transformers": "^2.17.2",
    "node-llama-cpp": "^3.21.1",
    "pdf-parse": "^1.1.1",
    "yoctocolors": "^2.1.2"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "protobufjs@6.11.6": true,
    "node-llama-cpp@3.21.1": true
  }
}
